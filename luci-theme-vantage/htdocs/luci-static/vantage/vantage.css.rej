-.vt-login { width: min(380px, 100%); }
+.vt-login {
+	width: min(380px, 100%);
+	z-index: 1;
+}
+.vt-login-page{
+	background:none !important;
+}
+.vt-login-page::before {
+	content: "";
+	position: absolute;
+	inset: 0;
+	background-image: url('/luci-static/vantage/pattern.svg');
+	background-size: 440px auto;
+	background-position: center;
+	opacity: 0.4;
+}
+html:not([data-darkmode="true"]) .vt-login-page::before {
+	opacity: 0.7;
+}
+#packages {
+ width: 100% !important;
+}
